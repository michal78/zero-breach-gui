<Window x:Class="ZeroBreach.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Zero Breach" Width="1120" Height="840" MinWidth="860" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="14" Closing="OnClosing">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#14233A"><Grid Margin="26,32">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <Border Width="46" Height="50" HorizontalAlignment="Left" Margin="0,0,0,20" Background="#213F60" CornerRadius="12"><Viewbox Margin="10"><Path Stroke="#70DAC4" StrokeThickness="2" Data="M 12,1 L 22,5 L 22,14 C 21,20 16,24 12,26 C 8,24 3,20 2,14 L 2,5 Z M 7,13 L 11,17 L 18,9"/></Viewbox></Border>
    <TextBlock Text="ZERO BREACH" FontWeight="Bold" FontSize="20" Foreground="White"/>
    <TextBlock Text="LOCAL SPYWARE CHECK" FontSize="10" Foreground="#95A9C4" Margin="0,8,0,0"/>
    <Border Height="1" Background="#314057" Margin="0,30,0,26"/>
    <TextBlock Text="A simple check.&#10;Evidence you can understand." FontSize="20" Foreground="#F5F8FC" FontWeight="SemiBold"/>
    <TextBlock Text="Checks for known traces of the AdFection / Candiru spyware campaigns in this Windows account." Foreground="#ADBBD0" Margin="0,18,0,0" FontSize="13"/>
    <TextBlock Text="01   Verify the latest scanner&#10;&#10;02   Scan local records&#10;&#10;03   Understand the result" Foreground="#B9C8DC" Margin="0,32,0,0" FontSize="12"/>
   </StackPanel>
   <StackPanel Grid.Row="2"><TextBlock Text="Your scan stays on this device." Foreground="#70DAC4" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="No uploads. No automatic changes." Foreground="#95A9C4" FontSize="11" Margin="0,7,0,18"/><Button Content="About &amp; notices" Click="About_Click" Background="#23354F" Foreground="#CFDCEC" FontSize="12" Padding="10,9" Margin="0"/></StackPanel>
  </Grid></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="34,28,34,28">
   <DockPanel Margin="0,0,0,22"><TextBlock Text="DEVICE CHECK" Foreground="#66758B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/><Border HorizontalAlignment="Right" Background="#E2ECE9" Padding="10,5" CornerRadius="12"><TextBlock Text="LOCAL · READ-ONLY" FontSize="10" Foreground="#2D6558" FontWeight="SemiBold"/></Border></DockPanel>
   <TextBlock Text="A clearer view of your device." FontSize="30" FontWeight="SemiBold"/>
   <TextBlock Text="Check for known spyware indicators, then see what the evidence means." Foreground="#63728A" Margin="0,9,0,22" FontSize="14"/>
   <Border Background="White" CornerRadius="12" Padding="22" BorderBrush="#E1E6EF" BorderThickness="1">
    <StackPanel>
     <TextBlock Text="Choose your scan" FontSize="17" FontWeight="SemiBold"/>
     <Grid Margin="0,16,0,15"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><RadioButton x:Name="Standard" GroupName="ScanMode" IsChecked="True" Content="Standard scan" FontWeight="SemiBold"/><TextBlock Text="Browser traces, file fingerprints and Windows records." FontSize="12" Foreground="#6A7890" Margin="21,6,0,0"/></StackPanel>
      <StackPanel Grid.Column="1"><RadioButton x:Name="Quick" GroupName="ScanMode" Content="Quick scan" FontWeight="SemiBold"/><TextBlock Text="Skips file fingerprints for a faster, less complete check." FontSize="12" Foreground="#6A7890" Margin="21,6,0,0"/></StackPanel>
     </Grid>
     <TextBlock Text="Before you start: close your browsers for better coverage. You can keep them open, but some records may be unavailable." FontSize="12" Foreground="#60718A" Margin="0,0,0,17"/>
     <WrapPanel><Button x:Name="StartButton" Content="Start scan" Click="Start_Click" Background="#2564DF" Foreground="White" FontWeight="SemiBold" MinWidth="150"/><Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed"/><Button x:Name="SavedButton" Content="Scan with saved version" Click="Saved_Click" Visibility="Collapsed"/></WrapPanel>
     <ProgressBar x:Name="Progress" Height="4" Margin="0,18,0,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="#2564DF"/>
     <TextBlock x:Name="StatusText" Text="Ready. The latest official scanner will be verified before it runs." Margin="0,14,0,0" FontSize="12" Foreground="#52647F"/>
     <TextBlock x:Name="ElapsedText" Foreground="#73829A" FontSize="11" Margin="0,5,0,0"/>
    </StackPanel>
   </Border>
   <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#FFF1E5" BorderBrush="#F2C79B" BorderThickness="1" CornerRadius="9" Padding="18" Margin="0,18,0,0"><TextBox x:Name="ErrorText" Style="{StaticResource Selectable}" Foreground="#83451A"/></Border>
   <Border x:Name="ResultPanel" Visibility="Collapsed" Background="White" CornerRadius="12" Padding="22" Margin="0,20,0,0" BorderBrush="#E1E6EF" BorderThickness="1"><StackPanel>
    <TextBlock x:Name="ResultEyebrow" FontSize="11" Foreground="#61748C" FontWeight="SemiBold"/>
    <TextBlock x:Name="ResultTitle" FontSize="24" FontWeight="SemiBold" Margin="0,9,0,10"/>
    <TextBlock x:Name="ResultSummary" Foreground="#52647F" Margin="0,0,0,18"/>
    <TabControl Background="White" BorderBrush="#E0E6EF" Padding="14">
     <TabItem x:Name="FindingsTab" Header="Findings"><ScrollViewer MaxHeight="390" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock x:Name="EmptyFindings" Text="No known indicator matched in the records that could be checked." Margin="0,5,0,10"/><ItemsControl x:Name="FindingsList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#DDE5EF" BorderThickness="0,0,0,1" Padding="0,12"><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/><TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource Selectable}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Coverage &amp; gaps"><ScrollViewer MaxHeight="390" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="WHAT COULD NOT BE CHECKED" FontWeight="Bold" FontSize="12" Foreground="#98591B" Margin="0,6,0,10"/><TextBox x:Name="GapsText" Style="{StaticResource Selectable}"/><TextBlock Text="WHAT WAS CHECKED" FontWeight="Bold" FontSize="12" Margin="0,22,0,10"/><TextBox x:Name="CoverageText" Style="{StaticResource Selectable}"/></StackPanel></ScrollViewer></TabItem>
     <TabItem x:Name="NextTab" Header="Next steps"><ScrollViewer MaxHeight="390" VerticalScrollBarVisibility="Auto"><TextBox x:Name="NextText" Style="{StaticResource Selectable}" Margin="0,6"/></ScrollViewer></TabItem>
    </TabControl>
    <WrapPanel Margin="0,18,0,0"><Button Content="Save readable report" Click="SaveText_Click" FontSize="12"/><Button Content="Save original JSON" Click="SaveJson_Click" FontSize="12"/></WrapPanel>
    <TextBlock Text="Reports may contain usernames, profile names, local paths and browsing details. Original JSON retains raw indicator addresses; share it securely and do not open those addresses." FontSize="11" Foreground="#74829A" Margin="0,12,0,0"/>
   </StackPanel></Border>
   <TextBlock Text="A scan can narrow uncertainty. It cannot prove a device is free of spyware. This app checks known traces for the current account; it does not replace antivirus or an expert investigation." FontSize="11" Foreground="#74829A" Margin="2,20,2,0"/>
   <Button Content="Diagnostic details" Click="Diagnostics_Click" HorizontalAlignment="Left" FontSize="11" Padding="0,8" Background="Transparent" Foreground="#6A7890" Margin="0,8,0,0"/>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
